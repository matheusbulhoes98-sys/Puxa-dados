	sh.Position = UDim2.new(0, -10, 0, -10)
	sh.ZIndex = parent.ZIndex - 1
	sh.Parent = parent
	return sh
end

--====================================================
-- SERIALIZAR ARGUMENTOS
--====================================================

local function serializeArg(arg, depth)
	depth = depth or 0
	if depth > 3 then return "..." end
	local t = typeof(arg)
	if t == "string" then return '"' .. arg:sub(1, 80) .. '"' end
	if t == "number" then return tostring(arg) end
	if t == "boolean" then return tostring(arg) end
	if t == "nil" then return "nil" end
	if t == "Instance" then return arg.ClassName .. ': "' .. arg.Name .. '"' end
	if t == "Vector3" then return string.format("Vector3.new(%.1f, %.1f, %.1f)", arg.X, arg.Y, arg.Z) end
	if t == "CFrame" then
		local x, y, z = arg:GetComponents()
		return string.format("CFrame.new(%.1f, %.1f, %.1f)", x, y, z)
	end
	if t == "Color3" then return string.format("Color3.fromRGB(%d, %d, %d)", arg.R*255, arg.G*255, arg.B*255) end
	if t == "table" then
		local c = 0
		for _ in pairs(arg) do c = c + 1; if c > 5 then break end end
		return "{... " .. c .. " itens}"
	end
	if t == "function" then return "function()" end
	return t .. ": " .. tostring(arg):sub(1, 40)
end

