local function tween(obj, props, dur, style, dir)
	local t = TweenService:Create(obj, TweenInfo.new(dur or 0.3, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function createCorner(parent, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 10)
	c.Parent = parent
	return c
end

local function createStroke(parent, color, thick)
	local s = Instance.new("UIStroke")
	s.Color = color or CONFIG.Theme.Accent
	s.Thickness = thick or 1
	s.Parent = parent
	return s
end

local function createShadow(parent)
